/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zendesk-mcp",
	"main": "src/index.ts",
	// Matched to the build date of the workerd that ships with the pinned wrangler, which is
	// the newest date that runtime knows about. Setting it further ahead only earns a warning
	// and no new behaviour, so when this moves again, read the workerd version out of the
	// lockfile and use that date rather than today's.
	"compatibility_date": "2026-07-22",
	// nodejs_compat_populate_process_env became default on 2025-04-01, and the date above now
	// sits past it, so vars and secrets would otherwise be copied onto process.env. Nothing in
	// the bundle reads process.env — not this code and none of the dependencies — so declining
	// it costs nothing and keeps the credentials reachable only through the env binding, which
	// has to be passed rather than read off a global.
	//
	// This narrows the surface rather than closing it. Anything able to read process.env could
	// equally patch globalThis.fetch, and zendesk-client.ts puts a Basic credential on every
	// outbound call, so treat this as one layer and not as a boundary.
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
	// #40 moved the server onto MCP revision 2026-07-28, which has no sessions, so there is
	// nothing left for a Durable Object to hold. v2 is what actually retires the class —
	// deleting the binding alone fails the deploy, because Cloudflare will not drop a class it
	// still has state for without being told to. v1 has to stay: the list is a history rather
	// than a description, and removing an applied entry re-runs everything after it.
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1",
		},
		{
			"deleted_classes": ["MyMCP"],
			"tag": "v2",
		},
	],
	"kv_namespaces": [
		{
			// pnpm exec wrangler kv namespace create ZENDESK_MCP_OAUTH
			"binding": "OAUTH_KV",
			"id": "c862c2ee524d4a45b0f531c67b6add15",
		},
	],
	// Credentials stay out of this file and are held as secrets — including ZENDESK_SUBDOMAIN
	// and ZENDESK_EMAIL, neither of which is sensitive. A dashboard-set plain var would not
	// survive: Workers Builds deploys the production branch with `wrangler deploy`, which
	// honours the setting below, but builds every other branch with `wrangler versions upload`,
	// which takes no equivalent and clears plain vars while leaving encrypted ones alone.
	//
	// Vars declared in this file are different. They are re-stated from the file on every
	// deploy path, so they survive both commands, and they ride the same review, versioning and
	// rollback as the code that reads them — which is why non-secret deployment policy belongs
	// here rather than in a secret. The caveat: a dashboard edit to a file var takes effect
	// immediately, is invisible to git, and silently reverts on the next deploy. Change the
	// file, not the dashboard.
	//
	// keep_vars stays because it still covers `wrangler deploy` for any dashboard var added
	// later. It is just not what protects the credentials.
	// For local development, put the secrets in .dev.vars — see .dev.vars.example.
	"keep_vars": true,
	"vars": {
		// The reach this deployment permits each tool group, resolved by `resolveCeilings` from
		// @levibe/mcp-worker's registry: read < stage < write < delete, and a tool is offered only
		// when its declared level fits under its group's ceiling. Malformed or missing, every
		// group falls closed to read. Every group in toolCategories must be named here — a unit
		// test parses this file and fails `validate` when the two drift.
		"TOOL_CEILINGS": {
			"tickets": "read",
			"users": "read",
			"organizations": "read",
			"groups": "read",
			"macros": "stage",
			"views": "read",
			"triggers": "read",
			"automations": "read",
			"search": "read",
			"helpCenter": "read",
			"support": "read",
			"talk": "read",
			"chat": "read",
		},
	},
	"observability": {
		"enabled": true,
	},
	"dev": {
		"port": 8788,
	},
}
