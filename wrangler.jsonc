/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zendesk-mcp",
	"main": "src/index.ts",
	// Matched to the build date of the workerd that ships with the pinned wrangler, which is
	// the newest date that runtime knows about. Setting it further ahead only earns a warning
	// and no new behaviour, so when this moves again, read the workerd version out of the
	// lockfile and use that date rather than today's.
	"compatibility_date": "2026-07-22",
	// nodejs_compat_populate_process_env became default on 2025-04-01, and the date above now
	// sits past it, so vars and secrets would otherwise be copied onto process.env. Nothing in
	// the bundle reads process.env — not this code and none of the dependencies — so declining
	// it costs nothing and keeps the credentials reachable only through the env binding, which
	// has to be passed rather than read off a global.
	//
	// This narrows the surface rather than closing it. Anything able to read process.env could
	// equally patch globalThis.fetch, and zendesk-client.ts puts a Basic credential on every
	// outbound call, so treat this as one layer and not as a boundary.
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
	// #40 moved the server onto MCP revision 2026-07-28, which has no sessions, so there is
	// nothing left for a Durable Object to hold. v2 is what actually retires the class —
	// deleting the binding alone fails the deploy, because Cloudflare will not drop a class it
	// still has state for without being told to. v1 has to stay: the list is a history rather
	// than a description, and removing an applied entry re-runs everything after it.
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1",
		},
		{
			"deleted_classes": ["MyMCP"],
			"tag": "v2",
		},
	],
	"kv_namespaces": [
		{
			// pnpm exec wrangler kv namespace create ZENDESK_MCP_OAUTH
			"binding": "OAUTH_KV",
			"id": "c862c2ee524d4a45b0f531c67b6add15",
		},
	],
	// Deployment-specific config (ZENDESK_SUBDOMAIN, ZENDESK_EMAIL) is set as plaintext
	// vars in the Cloudflare dashboard rather than committed here, so this repo stays
	// generic. keep_vars stops `wrangler deploy` treating this file as the source of
	// truth and wiping them. Secrets (ZENDESK_API_TOKEN, GOOGLE_*) persist regardless.
	// For local development, put all of them in .dev.vars — see .dev.vars.example.
	"keep_vars": true,
	"observability": {
		"enabled": true,
	},
	"dev": {
		"port": 8788,
	},
}
