# @levibe packages resolve from GitHub Packages. Only the registry mapping lives here:
# the credential has to come from user-level config (~/.npmrc locally, `pnpm config set`
# on CI and Workers Builds), because pnpm 11 refuses to expand env-var credentials from a
# project-level file and then sends no auth header at all — levibe/mcp-worker#5.
@levibe:registry=https://npm.pkg.github.com
